-  const fmtCDLabel = (cd: IMajorCooldownInfo) =>
-    `${cd.spellName} [${cd.cooldownSeconds}s${cd.maxChargesDetected > 1 ? `, ${cd.maxChargesDetected} Charges` : ''}]`;
