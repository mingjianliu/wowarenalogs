#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

npm run lint
npm run typecheck

# Deterministic prompt-quality gate (measured metrics, never rubric scores —
# see AGENTS.md Eval Integrity). Runs only when a local eval corpus exists;
# STRICT=1 fails the commit if any friendly death is missing from its prompt.
if [ -f packages/tools/local-batch/healer-eval/index.json ] && [ -d packages/tools/local-batch/healer-eval/manifests ]; then
  STRICT=1 npm run -w @wowarenalogs/tools start:promptQualityCheck
  # Score provenance: post-2026-07-07 scores must carry judge model + artifact
  # hashes; tampered or fabricated scores fail here (legacy files warn only).
  node scripts/check-score-provenance.mjs
else
  echo "[pre-commit] WARNING: local healer-eval corpus not found — promptQualityCheck gate SKIPPED"
fi
